generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Пункт меню пользователя; изоляция по email (как в diabalance через userId).
model MenuItem {
  id                  String   @id @default(cuid())
  userEmail           String
  name                String
  carbsPer100g        Float
  caloriesPer100g     Float?
  defaultPortionGrams Float    @default(100)
  proteinPer100g      Float?
  fatPer100g          Float?
  recipeText          String?
  barcode             String?
  barcodeAliases      String[] @default([])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([userEmail, barcode])
  @@index([userEmail])
  @@index([userEmail, name])
}
